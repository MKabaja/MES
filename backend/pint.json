{
  "preset": "laravel",
  "rules": {
    "declare_strict_types": true,
    "final_class": false,
    "final_internal_class": false,
    "fully_qualified_strict_types": true,
    "global_namespace_import": { "import_classes": true },
    "ordered_class_elements": true,
    "strict_comparison": true,
    "void_return": true
  }
}
